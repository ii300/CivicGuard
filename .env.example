# Local defaults. Copy to .env; never commit real secrets.
APP_ENV=development
# Blank creates a persistent private local key automatically.
# Production: generate at least 32 random characters; Render does this for you.
SECRET_KEY=
# Empty uses local alerts.db; production requires PostgreSQL.
DATABASE_URL=
# Canonical address used in verification/reset emails. No trailing slash.
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Production hostnames, comma separated (no scheme or path).
# Render automatically supplies RENDER_EXTERNAL_HOSTNAME as the default.
TRUSTED_HOSTS=
# Set to 1 only behind a single trusted reverse proxy, such as Render.
TRUST_PROXY=0

# file = development-only previews; smtp = real account emails.
MAIL_BACKEND=file
MAIL_FROM=CivicGuard <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional: accounts, maps, and saved drafts work without an AI key.
# AI draft requests incur provider charges. Never commit real credentials.
ANTHROPIC_API_KEY=
# Set a Messages API model ID available to your Anthropic account.
ANTHROPIC_MODEL=
